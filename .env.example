# 旧Googleアダプター用（現在のOSM推薦では未使用・設定不要）。
GOOGLE_MAPS_API_KEY=
# 将来の公開URL設定用。現時点では未使用です。
NEXT_PUBLIC_APP_URL=
# 任意: Overpassの接続先。空なら既定の公開サーバー。HTTPSのみ。
OSM_OVERPASS_URL=
# 目的地の封印鍵（サーバー専用・任意の長い乱数）。未設定時はプロセスごとの乱数鍵を使う。
ADVENTURE_SEAL_SECRET=
# デモ用の固定（未設定なら通常動作）。ジャンルは roadside_station / nature / cafe / history / hot_spring。
DEMO_PIN_GENRE=
DEMO_PIN_DESTINATION_ID=
DEMO_SEED=
# 固定の出発地「緯度,経度」。設定するとGPSを使わない（ブラウザへ公開される値）。
NEXT_PUBLIC_DEMO_ORIGIN=
